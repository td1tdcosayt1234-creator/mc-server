PORT=3000
# Firebase - service account JSON path, khali rakhle local db.json use hobe
FIREBASE_SERVICE_ACCOUNT=./serviceAccount.json
FIRESTORE_PROJECT_ID=
# Google Drive - service account diye backup, khali rakhle local ./backups use hobe
GOOGLE_SERVICE_ACCOUNT=./serviceAccount.json
DRIVE_FOLDER_ID=
# Backup proti koto minute por por (user chaise 50m)
BACKUP_MINUTES=50
# Minecraft servers folder
SERVERS_DIR=./servers
BACKUPS_DIR=./backups
